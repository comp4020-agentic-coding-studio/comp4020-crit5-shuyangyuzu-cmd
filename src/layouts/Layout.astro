---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Replace this with one sentence saying what this page is. A search result and a link preview both show it." } = Astro.props;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23111'/%3E%3Ccircle cx='16' cy='16' r='10' fill='%23e8d24a'/%3E%3C/svg%3E"
    />
    <title>{title}</title>
    <meta
      name="description"
      content={description}
    />

    <!--
      The link-preview card: public/card.png, 1200x630 --- replace it. The URL
      resolves against this page, like any link. No og:title/og:description:
      scrapers fall back to the <title> and description above.
    -->
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/comp4020-crit5-shuyangyuzu-cmd/card.png" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <slot />
  </body>
</html>
