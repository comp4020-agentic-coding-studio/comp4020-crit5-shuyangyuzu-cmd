---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="GOING, GOING&hellip;"
  description="A live-nerve art auction. Twelve lots, four collectors, one falling price."
>
  <header class="topbar">
    <nav aria-label="Primary">
      <a href="./" class="wordmark">GOING, GOING&hellip;</a>
      <div class="mode-switch" role="group" aria-label="Game mode">
        <button type="button" id="mode-house" class="mode-button" aria-pressed="true">HOUSE</button>
        <button type="button" id="mode-auctioneer" class="mode-button" aria-pressed="false">AUCTIONEER</button>
      </div>
    </nav>
  </header>
  <main id="app">
    <div id="ready-screen" class="ready-screen">
      <h1 class="ready-title">GOING, GOING&hellip;</h1>
      <div class="ready-frame">
        <canvas
          id="ready-artwork-canvas"
          class="ready-frame-canvas"
          role="img"
          aria-label="The Starry Night by Vincent van Gogh, 1889 — pixel-art interpretation"
        ></canvas>
      </div>
      <button type="button" id="enter-auction" class="enter-auction">ENTER AUCTION</button>
    </div>

    <div id="game-screen" class="game-screen" hidden>
      <div class="game-layout">
        <section class="panel panel-market" aria-labelledby="market-panel-title">
          <h2 id="market-panel-title" class="panel-title">MARKET</h2>
          <div id="market-board" class="market-board"></div>
        </section>

        <div class="panel-stage">
          <div id="auctioneer-banner" class="auctioneer-banner">
            <span class="gavel" aria-hidden="true">&#128296;</span>
            <span id="auctioneer-label">AUCTIONEER: HOUSE</span>
          </div>

          <div id="selecting-panel" class="selecting-panel" hidden>
            <p class="selecting-heading"><span class="gavel" aria-hidden="true">&#128296;</span> YOUR AUCTION</p>
            <div id="hand-cards" class="hand-cards"></div>
          </div>

          <div id="lot-caption" class="lot-caption">
            <span id="artist-swatch" class="swatch"></span>
            <span id="artist-name" class="lot-caption-name"></span>
            <span id="artwork-title" class="artwork-title"></span>
          </div>

          <div id="bid-market-compare" class="bid-market-compare" hidden>
            <div class="bid-market-stat">
              <span class="hud-label">CURRENT BID</span>
              <span id="bid-compare-value" class="bid-market-value">$0</span>
            </div>
            <span id="bid-market-indicator" class="bid-market-indicator" aria-hidden="true">
              <span id="bid-market-arrow" class="bid-market-arrow" aria-hidden="true"></span>
              <span id="bid-market-label" class="bid-market-label"></span>
            </span>
            <div class="bid-market-stat">
              <span class="hud-label">MARKET VALUE</span>
              <span id="market-compare-value" class="bid-market-value">$0</span>
            </div>
          </div>

          <div class="stage" id="stage">
            <button type="button" id="artwork-button" class="artwork" aria-label="Claim this artwork">
              <canvas id="artwork-canvas" aria-hidden="true"></canvas>
              <span id="outcome-tag" class="outcome-tag" hidden></span>
              <span id="sold-banner" class="sold-banner" hidden></span>
              <span id="bid-overlay" class="bid-overlay" aria-hidden="true">
                <span class="bid-overlay-icon">&#128296;</span>
                <span id="bid-overlay-label" class="bid-overlay-label">BID $0</span>
              </span>
            </button>

            <div class="price-rail" aria-live="off">
              <span id="price-tag" class="price-tag">$0</span>
            </div>
          </div>

          <div id="payment-flow" class="payment-flow" hidden></div>
        </div>

        <section class="panel panel-ledger" aria-labelledby="ledger-panel-title">
          <h2 id="ledger-panel-title" class="panel-title">LEDGER</h2>
          <div class="networth">
            <span class="hud-label">NET WORTH = CASH + COLLECTION</span>
            <span id="net-worth-formula" class="networth-formula">$0 = $0 + $0</span>
          </div>
          <div class="hud">
            <div class="hud-cell hud-cash">
              <span class="hud-label">CASH</span>
              <span id="player-cash" class="hud-value">$0</span>
            </div>
            <div class="hud-cell hud-lot">
              <span class="hud-label">LOT</span>
              <span id="lot-counter" class="hud-value">1 / 12</span>
            </div>
          </div>
          <div id="collection-board" class="collection"></div>
        </section>

        <section class="panel panel-rivals" aria-labelledby="rivals-panel-title">
          <h2 id="rivals-panel-title" class="panel-title">COLLECTORS</h2>
          <div id="rivals-board" class="rivals-board"></div>
        </section>
      </div>

      <div id="end-screen" class="end-screen" hidden>
        <p id="end-result" class="end-result">WIN</p>
        <ol id="ranking-list" class="ranking-list"></ol>
        <button type="button" id="play-again" class="play-again">PLAY AGAIN</button>
      </div>

      <div id="npc-dock" class="npc-dock" hidden aria-label="Collector interest"></div>
    </div>
  </main>
  <script src="../scripts/main.ts"></script>
</Layout>
